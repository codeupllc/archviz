# Copy to .env (gitignored) and fill in values as needed.
# Loaded by `pnpm runner` / archviz-runner (also reads sibling ../archviz-enterprise/.env).

# LocalStack — default image is localstack/localstack:4.14.0 (no token).
# For trial / current LocalStack:
LOCALSTACK_IMAGE=localstack/localstack:latest
LOCALSTACK_AUTH_TOKEN=
# LOCALSTACK_ENDPOINT=http://127.0.0.1:4566
